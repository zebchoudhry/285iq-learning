# 285IQ Environment Variables
# Copy to .env and set values. For Docker: set DB_PASSWORD and SECRET_KEY at minimum.

# Required in production
SECRET_KEY=your-super-secret-key-here-change-this
DEBUG=True

# Database (optional; if DB_ENGINE is not PostgreSQL, SQLite is used)
# For Docker Compose, set DB_ENGINE and DB_PASSWORD; other defaults work.
# If .env sets PostgreSQL but you have no psycopg2 (e.g. local dev), set:
# USE_SQLITE=true
USE_SQLITE=false
DB_ENGINE=
DB_NAME=285iq_db
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# Allowed hosts (comma-separated). Production: your domain(s)
ALLOWED_HOSTS=localhost,127.0.0.1,285iq.com,www.285iq.com

# Email (password reset, notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@285iq.com
# Production SMTP example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Optional: CSRF trusted origins if frontend on different domain (e.g. https://app.285iq.com)
# CSRF_TRUSTED_ORIGINS=https://app.285iq.com

# LLM (for AI-generated questions, tutor, diagnostics, etc.)
# Backends: disabled | mock | openai_compatible | huggingface
LLM_BACKEND=disabled
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_USE_FOR_QUIZ=false
LLM_USE_TUTOR=true

# Hugging Face — option 1: Inference Providers (LLM_BACKEND=huggingface)
# Get token: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# HF_PROVIDER=together

# Hugging Face — option 2: dedicated Inference Endpoint (OpenAI-compatible TGI)
# LLM_BACKEND=openai_compatible
# LLM_BASE_URL=https://YOUR-ENDPOINT.endpoints.huggingface.cloud/v1
# LLM_MODEL=deployment-name
# LLM_API_KEY=hf_...

# Semantic near-duplicate detection for questions (pip install sentence-transformers)
HF_EMBEDDINGS_ENABLED=false
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
